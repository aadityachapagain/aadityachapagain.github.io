{
    "compilerOptions": {
      "target": "es2020",
      "module": "es2020",
      "lib": ["es2020", "webworker"],
      "types": ["@cloudflare/workers-types"],
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    }
  }